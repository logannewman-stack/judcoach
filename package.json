{
  "name": "grit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "build:app": "vite build",
    "build:single": "VITE_SINGLE_FILE=1 SINGLE_FILE=1 vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "artifact": "npm run build:single && node scripts/make-artifact.mjs",
    "walk": "node scripts/walk.mjs ./.walk",
    "audit": "node scripts/audit.mjs ./.audit",
    "typecheck": "tsc -b --noEmit",
    "persist": "node scripts/persist.mjs",
    "recover": "node scripts/recover.mjs",
    "offline": "npm run build:app && node scripts/offline.mjs",
    "gesture": "node scripts/gesture.mjs",
    "coach": "node scripts/coach.mjs",
    "conform": "node scripts/conform.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
